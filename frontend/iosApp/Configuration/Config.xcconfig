TEAM_ID=

PRODUCT_NAME=eolssu
PRODUCT_BUNDLE_IDENTIFIER=com.ssafy.eolssu

FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../shared/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)"
OTHER_LDFLAGS = $(inherited) -framework Shared

CURRENT_PROJECT_VERSION=2
MARKETING_VERSION=1.0

// Sign in with Apple (S15P31E102-446). Requires a paid Apple Developer team.
// A free Personal Team cannot sign this capability: set `CODE_SIGN_ENTITLEMENTS =` in Config.local.xcconfig to build without Apple sign-in.
CODE_SIGN_ENTITLEMENTS=iosApp/iosApp.entitlements

// Machine-specific signing settings; excluded from Git.
#include? "Config.local.xcconfig"
