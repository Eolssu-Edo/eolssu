// 기술 블로그 배포 파이프라인
// develop에 blog/ 변경이 머지되면 Hugo로 빌드하고, 결과물만 GitHub Pages 저장소에 push
// 필요: Jenkins 플러그인 GitLab, Docker Pipeline / Credentials ID 'github-blog-token' (Secret text)
pipeline {
  agent none

  options {
    disableConcurrentBuilds()
    timeout(time: 10, unit: 'MINUTES')
  }

  environment {
    HUGO_IMAGE = 'ghcr.io/gohugoio/hugo:v0.145.0'
    GH_REPO    = 'team-ido/team-ido.github.io'
    GH_BRANCH  = 'main'
    SITE_URL   = 'https://team-ido.github.io/'
  }

  triggers {
    gitlab(
      triggerOnPush: true,
      triggerOnMergeRequest: false,
      branchFilterType: 'NameBasedFilter',
      includeBranchesSpec: 'develop'
    )
  }

  stages {
    stage('Build') {
      // blog/가 바뀌었거나, 사람이 직접 실행했을 때만
      when {
        beforeAgent true
        anyOf {
          changeset 'blog/**'
          triggeredBy 'UserIdCause'
        }
      }
      agent {
        docker {
          image "${HUGO_IMAGE}"
          args '--entrypoint=""'
          reuseNode false
        }
      }
      steps {
        sh 'hugo --source blog --minify --cleanDestinationDir --baseURL "$SITE_URL"'
        stash name: 'site', includes: 'blog/public/**'
      }
    }

    stage('Deploy') {
      when {
        beforeAgent true
        anyOf {
          changeset 'blog/**'
          triggeredBy 'UserIdCause'
        }
      }
      agent any
      steps {
        unstash 'site'
        withCredentials([string(credentialsId: 'github-blog-token', variable: 'GH_TOKEN')]) {
          sh 'bash blog/scripts/deploy.sh'
        }
      }
    }
  }
}
