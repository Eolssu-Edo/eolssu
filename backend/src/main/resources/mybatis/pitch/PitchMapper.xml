<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.eolssu.backend.feature.pitch.infrastructure.persistence.PitchMapper">
    <select id="listInRange" resultType="com.ssafy.eolssu.backend.feature.pitch.infrastructure.persistence.PitchRow">
        SELECT id, yul, octave, hanja, hangul, semitone
        FROM pitches
        <where>
            <if test="lowSemitone != null">semitone &gt;= #{lowSemitone}</if>
            <if test="highSemitone != null">AND semitone &lt;= #{highSemitone}</if>
        </where>
        ORDER BY semitone, id
    </select>
    <select id="findById" resultType="com.ssafy.eolssu.backend.feature.pitch.infrastructure.persistence.PitchRow">
        SELECT id, yul, octave, hanja, hangul, semitone
        FROM pitches
        WHERE id = #{id}
    </select>
</mapper>
