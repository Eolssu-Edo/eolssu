<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.eolssu.backend.feature.term.infrastructure.persistence.TermMapper">
    <select id="findById" resultType="com.ssafy.eolssu.backend.feature.term.infrastructure.persistence.TermRow">
        SELECT id, code, version, title, content_url, is_required, seq, effective_at, created_at
        FROM terms
        WHERE id = #{id}
    </select>
</mapper>
