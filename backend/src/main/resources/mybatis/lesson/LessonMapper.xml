<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.eolssu.backend.feature.lesson.infrastructure.persistence.LessonMapper">
    <select id="findById" resultType="com.ssafy.eolssu.backend.feature.lesson.infrastructure.persistence.LessonRow">
        SELECT id, track, seq, title, judge_type, is_optional, content_json, status, created_at, updated_at
        FROM lessons
        WHERE id = #{id}
    </select>
</mapper>
