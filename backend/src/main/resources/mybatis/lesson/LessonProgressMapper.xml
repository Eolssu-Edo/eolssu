<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.eolssu.backend.feature.lesson.infrastructure.persistence.LessonProgressMapper">
    <select id="findById" resultType="com.ssafy.eolssu.backend.feature.lesson.infrastructure.persistence.LessonProgressRow">
        SELECT id, user_id, lesson_id, score, completed_at, created_at, updated_at
        FROM lesson_progress
        WHERE id = #{id}
    </select>
</mapper>
