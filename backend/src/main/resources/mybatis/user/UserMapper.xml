<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.eolssu.backend.feature.user.infrastructure.persistence.UserMapper">
    <select id="findById" resultType="com.ssafy.eolssu.backend.feature.user.infrastructure.persistence.UserRow">
        SELECT id, email, password_hash, nickname, instrument_id, notation_mode, last_login_at, created_at, updated_at, deleted_at
        FROM users
        WHERE id = #{id}
    </select>
</mapper>
