<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.eolssu.backend.feature.evaluation.infrastructure.persistence.EvaluationMapper">
    <select id="findById" resultType="com.ssafy.eolssu.backend.feature.evaluation.infrastructure.persistence.EvaluationRow">
        SELECT id, session_id, total_score, pitch_score, timing_score, duration_score, model_version, evaluated_at
        FROM evaluations
        WHERE id = #{id}
    </select>
</mapper>
