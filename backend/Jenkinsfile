pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
    }

    stages {
        stage('Clean backend outputs') {
            steps {
                dir('backend') {
                    sh './gradlew --daemon -Dorg.gradle.daemon.idletimeout=60000 clean'
                }
            }
        }

        stage('Compile backend') {
            steps {
                dir('backend') {
                    sh './gradlew --daemon -Dorg.gradle.daemon.idletimeout=60000 compileKotlin'
                }
            }
        }

        stage('Compile backend tests') {
            steps {
                dir('backend') {
                    sh './gradlew --daemon -Dorg.gradle.daemon.idletimeout=60000 compileTestKotlin'
                }
            }
        }

        stage('Backend unit tests') {
            steps {
                dir('backend') {
                    sh './gradlew --daemon -Dorg.gradle.daemon.idletimeout=60000 test'
                }
            }
            post { always { junit testResults: 'backend/build/test-results/test/*.xml', allowEmptyResults: false } }
        }

        stage('Package backend') {
            steps {
                dir('backend') {
                    sh './gradlew --daemon -Dorg.gradle.daemon.idletimeout=60000 build'
                }
            }
        }

        stage('Validate development Compose') {
            steps {
                sh '''
                docker compose --env-file .env.dev.example -f docker-compose.dev.yml config --quiet
                '''
            }
        }

        stage('Validate production Compose') {
            steps {
                sh '''
                docker compose --env-file .env.prod.example -f docker-compose.prod.yml config --quiet
                '''
            }
        }

        stage('Build image') {
            steps {
                sh 'docker build -f backend/Dockerfile --tag "eolsu-backend:ci-${GIT_COMMIT}" .'
            }
        }

        stage('Validate Nginx') {
            steps {
                sh '''
                    docker run --rm --network none \
                        --mount "type=bind,src=$WORKSPACE/infra/nginx/default.conf,dst=/etc/nginx/conf.d/default.conf,readonly" \
                        nginx:1.30.6-alpine nginx -t
                '''
            }
        }

        stage('Archive package') {
            steps {
                archiveArtifacts artifacts: 'backend/build/libs/eolsu-*-SNAPSHOT.jar', fingerprint: true
            }
        }
    }
}
