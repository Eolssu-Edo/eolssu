# 참고용 예시이며 Spring Boot가 .env를 자동으로 읽지는 않습니다.
# 실행할 터미널 또는 IDE 실행 설정에서 환경변수로 지정하세요.
SERVER_PORT=8080

# FE 개발 서버처럼 다른 주소에서 쿠키를 포함해 백엔드를 직접 부를 때만 쉼표로 구분해 지정합니다.
# 운영·Nginx 뒤 서버는 비워 둡니다. *는 쓸 수 없습니다(쿠키 허용과 함께 쓰면 오류).
# 예: FE 웹 개발 서버와 함께 개발할 때 SERVER_PORT=8081, SECURITY_ALLOWED_ORIGINS=http://localhost:8080
SECURITY_ALLOWED_ORIGINS=

# DB 기능을 사용할 때만 db 프로필을 활성화합니다. DB는 미리 생성합니다.
SPRING_PROFILES_ACTIVE=db
DB_URL=jdbc:mysql://localhost:3306/eolssu
DB_USERNAME=eolssu
DB_PASSWORD=

# databaseTest 전용. 운영 DB가 아닌 비어 있는 폐기 가능한 MySQL 8.4 DB를 지정합니다.
TEST_DB_URL=jdbc:mysql://localhost:3306/eolssu_test
TEST_DB_USERNAME=eolssu_test
TEST_DB_PASSWORD=
