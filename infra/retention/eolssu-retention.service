[Unit]
Description=Eolssu deployment release, CI image and build cache retention
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Runs hourly but only cleans when free space on / drops below 10 GiB.
ExecStart=/opt/eolssu/bin/eolssu-retention --apply --below-free-gib 10
TimeoutStartSec=30min
UMask=0077
Nice=10
IOSchedulingClass=idle
