{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "prometheus:9090을 가리키는 데이터 소스",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "얼쑤 백엔드 성능",
  "uid": "eolssu-backend",
  "tags": [
    "eolssu"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "API (수집 요청 /api/actuator 제외, 5분 평균)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API 평균 응답 시간",
      "description": "주소 패턴(uri)별 평균 응답 시간. 등록되지 않은 주소는 /**로 묶인다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{job=\"eolssu-backend\",uri!~\"/api/actuator.*\"}[5m])) / sum by (uri) (rate(http_server_requests_seconds_count{job=\"eolssu-backend\",uri!~\"/api/actuator.*\"}[5m]))",
          "legendFormat": "{{uri}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API 최대 응답 시간",
      "description": "주소 패턴별 최근 가장 느린 요청. 수치 라이브러리가 몇 분 단위로 다시 센다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (uri) (http_server_requests_seconds_max{job=\"eolssu-backend\",uri!~\"/api/actuator.*\"})",
          "legendFormat": "{{uri}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "상태 코드별 요청 수 (초당)",
      "description": "응답 상태 코드별 초당 요청 수.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"eolssu-backend\",uri!~\"/api/actuator.*\"}[5m]))",
          "legendFormat": "{{status}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "5xx 오류율",
      "description": "전체 요청 중 서버 오류(5xx) 비율. 오류가 없으면 0이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"eolssu-backend\",uri!~\"/api/actuator.*\",status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{job=\"eolssu-backend\",uri!~\"/api/actuator.*\"}[5m]))",
          "legendFormat": "5xx",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "JVM",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JVM 힙 메모리",
      "description": "힙 영역별 사용량과 최대값.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (id) (jvm_memory_used_bytes{job=\"eolssu-backend\",area=\"heap\"})",
          "legendFormat": "{{id}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(jvm_memory_max_bytes{job=\"eolssu-backend\",area=\"heap\"} > 0)",
          "legendFormat": "최대",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GC 멈춤 시간 (초당)",
      "description": "가비지 컬렉션으로 멈춘 시간의 초당 합.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (gc) (rate(jvm_gc_pause_seconds_sum{job=\"eolssu-backend\"}[5m]))",
          "legendFormat": "{{gc}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "스레드 수",
      "description": "살아 있는 JVM 스레드 수.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 18,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "jvm_threads_live_threads{job=\"eolssu-backend\"}",
          "legendFormat": "live",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "DB",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "DB 연결 풀 (ops 프로필에서만)",
      "description": "MySQL에 연결하는 ops 프로필에서만 나온다. 대기(pending)가 0보다 크면 연결이 모자란 것이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "hikaricp_connections_active{job=\"eolssu-backend\"}",
          "legendFormat": "사용 중",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "hikaricp_connections_idle{job=\"eolssu-backend\"}",
          "legendFormat": "쉬는 중",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "hikaricp_connections_pending{job=\"eolssu-backend\"}",
          "legendFormat": "대기",
          "range": true
        }
      ]
    }
  ]
}
