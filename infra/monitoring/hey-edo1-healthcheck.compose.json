{
  "services": {
    "n8n": {
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "body=$$(wget -q -T 3 -O - http://127.0.0.1:5678/healthz/readiness) && printf '%s\\n' \"$$body\" | grep -Eq '\"status\"[[:space:]]*:[[:space:]]*\"ok\"'"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "30s"
      }
    }
  }
}
