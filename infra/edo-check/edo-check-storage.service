[Unit]
Description=edo1 Docker and Jenkins storage measurements
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B -I /opt/edo-check/collector.py storage-snapshot edo1
TimeoutStartSec=235s
TimeoutStopSec=5s
StateDirectory=edo-check-storage
StateDirectoryMode=0700
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
MemoryMax=128M
TasksMax=16
