[Unit]
Description=Observe public relay and terms endpoints from edo1
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=edo-check-outside
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -B -I /opt/edo-check/outside.py
TimeoutStartSec=25s
# Drop routine service-manager messages. The script tags outage and recovery lines.
LogLevelMax=notice
# Unhandled Python errors must still appear in the journal.
SyslogLevel=err
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
