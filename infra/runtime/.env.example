# edo1의 기존 값을 확인해 사용합니다. 이 예시로 실제 .env를 덮어쓰지 않습니다.
WEB_DIST_DIR=/opt/eolssu/releases/RELEASE/web
BACKEND_JAR=/opt/eolssu/releases/RELEASE/app.jar
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
# 운영 DB 이름·사용자는 eolssu입니다.
MYSQL_DATABASE=eolssu
MYSQL_USER=eolssu
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# 로그인 토큰 서명 키. 32바이트 이상 무작위 값(openssl rand -base64 48). 비우면 로그인 토큰을 모두 거절합니다.
AUTH_JWT_SECRET=
AUTH_ANDROID_APP_SHA256_FINGERPRINTS=
# 이메일 인증번호 해시 키. 32바이트 이상 무작위 값. 비우면 인증번호 발송·확인(이메일 가입·비밀번호 재설정 포함)을 거절합니다.
AUTH_CODE_HMAC_SECRET=
# 인증 메일 발송(Gmail SMTP, 587 STARTTLS). 호스트·계정·앱 비밀번호 중 하나라도 비우면 메일 발송만 거절합니다.
AUTH_MAIL_HOST=smtp.gmail.com
AUTH_MAIL_PORT=587
AUTH_MAIL_USERNAME=eolssu.mailservice@gmail.com
AUTH_MAIL_PASSWORD=
# 비우면 AUTH_MAIL_USERNAME을 발신 주소로 씁니다.
AUTH_MAIL_FROM=eolssu.mailservice@gmail.com
AUTH_MAIL_FROM_NAME=얼쑤
# 간편 로그인. 제공자별로 비우면 그 제공자의 로그인만 거절합니다. 값은 백엔드가 개발자 콘솔에서 발급해 전달합니다.
AUTH_OAUTH_KAKAO_CLIENT_ID=
AUTH_OAUTH_KAKAO_CLIENT_SECRET=
# 카카오 콘솔 등록 완료 주소: https://k15e102.p.ssafy.io/auth/android/oauth/kakao/callback
AUTH_OAUTH_KAKAO_REDIRECT_URIS=
AUTH_OAUTH_GOOGLE_CLIENT_ID=
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
AUTH_OAUTH_GOOGLE_REDIRECT_URIS=
AUTH_OAUTH_NAVER_CLIENT_ID=
AUTH_OAUTH_NAVER_CLIENT_SECRET=
AUTH_OAUTH_NAVER_REDIRECT_URIS=
# 녹음 원본 저장소(S3 호환, Cloudflare R2). 하나라도 비우면 녹음 업로드만 503으로 거절합니다.
# 엔드포인트는 https://<account_id>.r2.cloudflarestorage.com, 키는 버킷 하나에 객체 읽기·쓰기만 허용한 R2 API 토큰의 S3 키입니다.
RECORDING_STORAGE_ENDPOINT=
RECORDING_STORAGE_BUCKET=
RECORDING_STORAGE_ACCESS_KEY_ID=
RECORDING_STORAGE_SECRET_ACCESS_KEY=
RECORDING_STORAGE_REGION=auto
# 기존 데이터 보존을 위해 물리 볼륨 이름을 명시합니다.
MYSQL_DATA_VOLUME=eolsu-runtime_mysql_data

# 기본은 빈 목록. 검토한 테스트 회원 ID에만 무기한 서버 세션 예외를 적용한다.
AUTH_NON_EXPIRING_USER_IDS=
