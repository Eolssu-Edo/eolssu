# config --quiet 전용 고정 데이터입니다. 이 값으로 서비스를 기동하지 않습니다.
WEB_DIST_DIR=/tmp/eolssu-ci/web
BACKEND_JAR=/tmp/eolssu-ci/app.jar
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=18080
MYSQL_DATABASE=ci_validation_only
MYSQL_USER=ci_validation_only
MYSQL_PASSWORD=ci-validation-only
MYSQL_ROOT_PASSWORD=ci-validation-only
MYSQL_DATA_VOLUME=eolssu-ci-unused
